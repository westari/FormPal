{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // supabase/functions/* are Deno Edge Functions, deployed separately via
  // `supabase functions deploy` — never bundled into the RN app, and Deno's
  // global APIs/import URLs don't match this project's RN/Node type setup.
  "exclude": [
    "node_modules",
    "supabase/functions/**/*"
  ]
}